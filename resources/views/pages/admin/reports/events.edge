@layout()
  <div class="admin-page">
    @include('partials/admin_nav')
    @include('partials/report_tabs')
    <div class="admin-heading">
      <div>
        <p class="admin-kicker">Reportes</p>
        <h1>Eventos</h1>
        <p class="admin-muted">Volumen de apuestas, pools liquidados y comisión por evento.</p>
      </div>
      <a class="admin-link" href="/admin/reports/events.csv?{{ qs }}">Descargar CSV</a>
    </div>

    <section class="admin-card">
      <form class="admin-filters" method="get" action="/admin/reports/events">
        <input name="search" placeholder="Buscar evento" value="{{ filters.search ?? '' }}" />
        <select name="status">
          <option value="">Todos los estados</option>
          @each(status in ['draft', 'scheduled', 'live', 'paused', 'finished', 'cancelled'])
            <option value="{{ status }}" @if(filters.status === status) selected @end>{{ status }}</option>
          @end
        </select>
        <label>
          Desde
          <input name="from" type="date" value="{{ filters.from ?? '' }}" />
        </label>
        <label>
          Hasta
          <input name="to" type="date" value="{{ filters.to ?? '' }}" />
        </label>
        <button type="submit">Filtrar</button>
      </form>
    </section>

    <section class="admin-card admin-table-card">
      @if(rows.length === 0)
        <p class="admin-muted">No hay eventos que coincidan.</p>
      @else
        <table class="admin-table">
          <thead>
            <tr>
              <th>Evento</th>
              <th>Estado</th>
              <th>Rondas</th>
              <th>Apuestas</th>
              <th>Volumen</th>
              <th>Pool</th>
              <th>Premios</th>
              <th>Comisión</th>
            </tr>
          </thead>
          <tbody>
            @each(event in rows)
              <tr>
                <td>
                  <strong>{{ event.name }}</strong>
                  <span class="admin-table-sub">{{ event.slug }}</span>
                </td>
                <td><span class="admin-status admin-status-{{ event.status }}">{{ event.status }}</span></td>
                <td>{{ event.rounds_count }}</td>
                <td>{{ event.bets_count }}</td>
                <td>{{ event.bets_volume }}</td>
                <td>{{ event.pool_total }}</td>
                <td>{{ event.payout_total }}</td>
                <td>{{ event.commission_total }}</td>
              </tr>
            @end
          </tbody>
        </table>
      @end
    </section>
  </div>
@end