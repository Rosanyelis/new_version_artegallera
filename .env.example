# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# PostgreSQL
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=artegallera
DB_PASSWORD=artegallera
DB_DATABASE=artegallera

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Streaming (public playback only; ingest credentials stay server-side)
STREAMING_PROVIDER=mediamtx
STREAMING_INGEST_URL=rtmp://localhost:1935/live
STREAMING_PLAYBACK_BASE_URL=http://localhost:8888/live
